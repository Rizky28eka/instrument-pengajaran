rules_version = '2';

/**
 * Model akses (deny-by-default):
 *
 *  - Akun Firebase Auth yang baru mendaftar TIDAK memiliki akses apa pun.
 *  - Akses diperoleh dengan menebus undangan (invites) yang dibuat admin sekolah; hasilnya
 *    dokumen profil users/{uid} berisi schoolId, role, dan status.
 *  - Semua data dibatasi per sekolah (schoolId). Tidak ada akses lintas sekolah.
 *  - Email wajib terverifikasi (token.email_verified) untuk semua akses.
 *  - Tidak ada hard-delete dari klien; penghapusan adalah soft-delete (deletedAt).
 *  - Setiap perubahan supervisi / tindakLanjut menaikkan `rev` sebesar 1 dan WAJIB disertai
 *    entri riwayat/{rev} pada batch yang sama (jejak audit + perlindungan lost update).
 *
 * Batasan yang diakui: seluruh pemeriksaan dilakukan terhadap data kiriman klien. Seorang
 * pengguna sah dalam sekolahnya dapat menulis nilai yang tidak konsisten (mis. ringkasan);
 * itu sebabnya aplikasi selalu menghitung ulang ringkasan dari skor saat membaca.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- pembantu umum

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return exists(profilePath(request.auth.uid));
    }

    function me() {
      return get(profilePath(request.auth.uid)).data;
    }

    // Pengguna aktif: email terverifikasi, punya profil, dan tidak dinonaktifkan.
    function active() {
      return verified() && hasProfile() && me().status == 'active';
    }

    function inSchool(schoolId) {
      return active() && me().schoolId == schoolId;
    }

    function isAdmin(schoolId) {
      return inSchool(schoolId) && me().role == 'admin';
    }

    function isStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    function isStrNonEmpty(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function isDateStr(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------------------------------------------------------------- sekolah

    match /schools/{schoolId} {
      // Dibuat lewat konsol / skrip admin (lihat docs/OPERASIONAL.md), bukan dari klien.
      allow get: if inSchool(schoolId);
      allow list, write: if false;
    }

    // ---------------------------------------------------------------- profil pengguna

    function validNewProfile(d, uid) {
      let invitePath = /databases/$(database)/documents/invites/$(d.inviteId);
      return d.keys().hasOnly(['email', 'nama', 'schoolId', 'role', 'status', 'inviteId', 'createdAt'])
        && d.keys().hasAll(['email', 'nama', 'schoolId', 'role', 'status', 'inviteId', 'createdAt'])
        && d.email == request.auth.token.email
        && isStrNonEmpty(d.nama, 100)
        && d.status == 'active'
        && d.createdAt == request.time
        && d.inviteId is string
        && exists(invitePath)
        && get(invitePath).data.usedBy == null
        && get(invitePath).data.expiresAt > request.time
        && get(invitePath).data.schoolId == d.schoolId
        && get(invitePath).data.role == d.role
        && (get(invitePath).data.email == null
            || get(invitePath).data.email.lower() == request.auth.token.email.lower())
        // Undangan harus ditandai terpakai oleh pengguna ini pada batch yang sama.
        && getAfter(invitePath).data.usedBy == uid;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin(resource.data.schoolId));
      allow list: if isAdmin(resource.data.schoolId);

      // Menebus undangan: hanya untuk dirinya sendiri, hanya sekali (dokumen belum ada).
      allow create: if verified()
        && request.auth.uid == uid
        && !hasProfile()
        && validNewProfile(request.resource.data, uid);

      // Admin sekolah hanya dapat mengubah status; tidak dapat menonaktifkan dirinya sendiri.
      allow update: if isAdmin(resource.data.schoolId)
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['active', 'disabled'];

      allow delete: if false;
    }

    // ---------------------------------------------------------------- undangan

    match /invites/{inviteId} {
      // ID undangan adalah token acak yang sulit ditebak; list tetap dibatasi untuk admin.
      allow get: if verified();
      allow list: if isAdmin(resource.data.schoolId);

      allow create: if isAdmin(request.resource.data.schoolId)
        && request.resource.data.keys().hasOnly(['schoolId', 'role', 'email', 'createdBy', 'createdAt', 'expiresAt', 'usedBy', 'usedAt'])
        && request.resource.data.keys().hasAll(['schoolId', 'role', 'email', 'createdBy', 'createdAt', 'expiresAt', 'usedBy', 'usedAt'])
        && request.resource.data.role in ['admin', 'supervisor']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd')
        && (request.resource.data.email == null || isStrNonEmpty(request.resource.data.email, 200))
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null
        && inviteId.size() >= 20;

      // Menebus: hanya mengisi usedBy/usedAt, hanya oleh pengguna itu sendiri, dan hanya bila
      // profilnya dibuat pada batch yang sama dan menunjuk undangan ini.
      allow update: if verified()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && existsAfter(profilePath(request.auth.uid))
        && getAfter(profilePath(request.auth.uid)).data.inviteId == inviteId;

      // Mencabut undangan yang belum terpakai.
      allow delete: if isAdmin(resource.data.schoolId) && resource.data.usedBy == null;
    }

    // ---------------------------------------------------------------- master data guru

    function validGuru(d) {
      return d.keys().hasOnly(['schoolId', 'nama', 'mapel', 'aktif', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['schoolId', 'nama', 'mapel', 'aktif', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && isStrNonEmpty(d.nama, 120)
        && isStr(d.mapel, 120)
        && d.aktif is bool
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /guru/{guruId} {
      allow read: if inSchool(resource.data.schoolId);

      allow create: if inSchool(request.resource.data.schoolId)
        && validGuru(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Identitas stabil: sekolah, pembuat, dan waktu pembuatan tidak dapat diubah.
      allow update: if inSchool(resource.data.schoolId)
        && validGuru(request.resource.data)
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // ---------------------------------------------------------------- supervisi

    function supervisiKeys() {
      return ['schoolId', 'guruId', 'guruNama', 'identitas', 'skor', 'catatanAspek', 'catatan', 'ringkasan',
              'versiInstrumen', 'instrumen', 'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'updatedBy',
              'rev', 'deletedAt', 'deletedBy'];
    }

    function validIdentitas(i) {
      return i is map
        && i.keys().hasOnly(['namaSekolah', 'namaGuru', 'mataPelajaran', 'kelas', 'namaSupervisor', 'tanggal',
                             'kurikulum', 'kurikulumLainnya', 'modelPembelajaran'])
        && i.keys().hasAll(['namaSekolah', 'namaGuru', 'mataPelajaran', 'kelas', 'namaSupervisor', 'tanggal',
                            'kurikulum', 'modelPembelajaran'])
        && isStrNonEmpty(i.namaSekolah, 150)
        && isStrNonEmpty(i.namaGuru, 120)
        && isStrNonEmpty(i.mataPelajaran, 120)
        && isStrNonEmpty(i.kelas, 40)
        && isStrNonEmpty(i.namaSupervisor, 120)
        && isDateStr(i.tanggal)
        && i.kurikulum in ['Kurikulum Merdeka', 'Kurikulum 2013', 'Lainnya']
        && (!('kurikulumLainnya' in i) || isStr(i.kurikulumLainnya, 120))
        && i.modelPembelajaran in ['Tatap Muka', 'Daring', 'Blended Learning'];
    }

    // Validasi isi (tanpa kolom metadata). Rentang skor 1–4 dipaksa di sini, bukan hanya di UI.
    function validIsiSupervisi(d) {
      return validIdentitas(d.identitas)
        && d.skor is map
        && d.skor.size() <= 120
        && d.skor.values().hasOnly([1, 2, 3, 4])
        && d.catatanAspek is map
        && d.catatanAspek.size() <= 20
        && d.catatan is map
        && d.catatan.keys().hasOnly(['kekuatan', 'perbaikan', 'rekomendasi'])
        && isStr(d.catatan.get('kekuatan', ''), 4000)
        && isStr(d.catatan.get('perbaikan', ''), 4000)
        && isStr(d.catatan.get('rekomendasi', ''), 4000)
        && d.ringkasan is map
        && d.ringkasan.total is int
        && d.ringkasan.maks is int
        && d.ringkasan.nilai is number
        && d.ringkasan.nilai >= 0
        && d.ringkasan.nilai <= 100
        && d.versiInstrumen is string
        && d.versiInstrumen.size() <= 60
        && d.instrumen is map
        && d.instrumen.versi == d.versiInstrumen
        && d.instrumen.aspek is list
        && d.instrumen.aspek.size() >= 1
        && d.instrumen.aspek.size() <= 20
        && d.instrumen.ambang is list
        && d.instrumen.ambang.size() >= 1
        && d.instrumen.ambang.size() <= 10;
    }

    function supervisiPath(id) {
      return /databases/$(database)/documents/supervisi/$(id);
    }

    match /supervisi/{id} {
      // Dokumen yang sudah di-soft-delete hanya terlihat oleh admin sekolahnya.
      allow read: if inSchool(resource.data.schoolId)
        && (resource.data.deletedAt == null || isAdmin(resource.data.schoolId));

      allow create: if inSchool(request.resource.data.schoolId)
        && request.resource.data.keys().hasOnly(supervisiKeys())
        && request.resource.data.keys().hasAll(supervisiKeys())
        && validIsiSupervisi(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && isStr(request.resource.data.createdByName, 120)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.rev == 1
        && request.resource.data.deletedAt == null
        && request.resource.data.deletedBy == null
        // Guru harus aktif dan milik sekolah yang sama.
        && get(/databases/$(database)/documents/guru/$(request.resource.data.guruId)).data.schoolId == request.resource.data.schoolId
        && get(/databases/$(database)/documents/guru/$(request.resource.data.guruId)).data.aktif == true
        && request.resource.data.guruNama == get(/databases/$(database)/documents/guru/$(request.resource.data.guruId)).data.nama
        && existsAfter(/databases/$(database)/documents/supervisi/$(id)/riwayat/1);

      allow update: if inSchool(resource.data.schoolId)
        && request.resource.data.keys().hasOnly(supervisiKeys())
        && request.resource.data.keys().hasAll(supervisiKeys())
        // Bidang yang tidak boleh berubah — termasuk versi dan snapshot instrumen.
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.guruId == resource.data.guruId
        && request.resource.data.guruNama == resource.data.guruNama
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.versiInstrumen == resource.data.versiInstrumen
        && request.resource.data.instrumen == resource.data.instrumen
        // Perlindungan lost update + jejak audit.
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/supervisi/$(id)/riwayat/$(string(request.resource.data.rev)))
        && (
          // (1) Ubah isi: pembuat atau admin, dokumen belum dihapus.
          (resource.data.deletedAt == null
            && request.resource.data.deletedAt == null
            && request.resource.data.deletedBy == null
            && (resource.data.createdBy == request.auth.uid || isAdmin(resource.data.schoolId))
            && validIsiSupervisi(request.resource.data))
          // (2) Soft-delete: pembuat atau admin; isi tidak boleh ikut berubah.
          || (resource.data.deletedAt == null
            && request.resource.data.deletedAt == request.time
            && request.resource.data.deletedBy == request.auth.uid
            && (resource.data.createdBy == request.auth.uid || isAdmin(resource.data.schoolId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy', 'rev', 'updatedAt', 'updatedBy']))
          // (3) Pulihkan: khusus admin; isi tidak boleh ikut berubah.
          || (resource.data.deletedAt != null
            && request.resource.data.deletedAt == null
            && request.resource.data.deletedBy == null
            && isAdmin(resource.data.schoolId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy', 'rev', 'updatedAt', 'updatedBy']))
        );

      allow delete: if false;

      // Riwayat append-only. Dibuat bersamaan dengan perubahan induknya (lihat existsAfter di atas).
      match /riwayat/{rev} {
        allow read: if inSchool(get(supervisiPath(id)).data.schoolId);

        allow create: if inSchool(getAfter(supervisiPath(id)).data.schoolId)
          && request.resource.data.keys().hasOnly(['aksi', 'oleh', 'olehNama', 'waktu', 'rev', 'ringkasan'])
          && request.resource.data.keys().hasAll(['aksi', 'oleh', 'olehNama', 'waktu', 'rev'])
          && request.resource.data.aksi in ['buat', 'ubah', 'hapus', 'pulihkan']
          && request.resource.data.oleh == request.auth.uid
          && isStr(request.resource.data.olehNama, 120)
          && request.resource.data.waktu == request.time
          && request.resource.data.rev is int
          && string(request.resource.data.rev) == rev
          && getAfter(supervisiPath(id)).data.rev == request.resource.data.rev
          && ((request.resource.data.aksi == 'buat') == (request.resource.data.rev == 1))
          && (request.resource.data.aksi != 'hapus' || getAfter(supervisiPath(id)).data.deletedAt != null)
          && (request.resource.data.aksi != 'ubah' && request.resource.data.aksi != 'pulihkan'
              || getAfter(supervisiPath(id)).data.deletedAt == null);

        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------- tindak lanjut

    function tindakKeys() {
      return ['schoolId', 'supervisiId', 'guruId', 'guruNama', 'deskripsi', 'status', 'penanggungJawab', 'tenggat',
              'selesaiAt', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'rev'];
    }

    function tindakPath(id) {
      return /databases/$(database)/documents/tindakLanjut/$(id);
    }

    function validTransisi(dari, ke) {
      return dari == ke
        || (dari == 'belum' && ke in ['proses', 'selesai', 'dibatalkan'])
        || (dari == 'proses' && ke in ['belum', 'selesai', 'dibatalkan'])
        || (dari == 'selesai' && ke == 'proses')
        || (dari == 'dibatalkan' && ke == 'belum');
    }

    function validIsiTindak(d) {
      return isStrNonEmpty(d.deskripsi, 2000)
        && d.status in ['belum', 'proses', 'selesai', 'dibatalkan']
        && isStr(d.penanggungJawab, 120)
        && (d.tenggat == null || isDateStr(d.tenggat))
        && isStrNonEmpty(d.guruNama, 120);
    }

    match /tindakLanjut/{id} {
      allow read: if inSchool(resource.data.schoolId);

      allow create: if inSchool(request.resource.data.schoolId)
        && request.resource.data.keys().hasOnly(tindakKeys())
        && request.resource.data.keys().hasAll(tindakKeys())
        && validIsiTindak(request.resource.data)
        && request.resource.data.status == 'belum'
        && request.resource.data.selesaiAt == null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.rev == 1
        // Terkait supervisi dan guru milik sekolah yang sama.
        && get(/databases/$(database)/documents/supervisi/$(request.resource.data.supervisiId)).data.schoolId == request.resource.data.schoolId
        && get(/databases/$(database)/documents/supervisi/$(request.resource.data.supervisiId)).data.guruId == request.resource.data.guruId
        && existsAfter(/databases/$(database)/documents/tindakLanjut/$(id)/riwayat/1);

      allow update: if inSchool(resource.data.schoolId)
        && request.resource.data.keys().hasOnly(tindakKeys())
        && request.resource.data.keys().hasAll(tindakKeys())
        && validIsiTindak(request.resource.data)
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.supervisiId == resource.data.supervisiId
        && request.resource.data.guruId == resource.data.guruId
        && request.resource.data.guruNama == resource.data.guruNama
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && validTransisi(resource.data.status, request.resource.data.status)
        && (request.resource.data.status == 'selesai'
            ? (resource.data.status == 'selesai'
                ? request.resource.data.selesaiAt == resource.data.selesaiAt
                : request.resource.data.selesaiAt == request.time)
            : request.resource.data.selesaiAt == null)
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/tindakLanjut/$(id)/riwayat/$(string(request.resource.data.rev)));

      allow delete: if false;

      match /riwayat/{rev} {
        allow read: if inSchool(get(tindakPath(id)).data.schoolId);

        allow create: if inSchool(getAfter(tindakPath(id)).data.schoolId)
          && request.resource.data.keys().hasOnly(['aksi', 'oleh', 'olehNama', 'waktu', 'rev', 'dari', 'ke', 'catatan'])
          && request.resource.data.keys().hasAll(['aksi', 'oleh', 'olehNama', 'waktu', 'rev'])
          && request.resource.data.aksi in ['buat', 'ubah', 'status', 'catatan']
          && request.resource.data.oleh == request.auth.uid
          && isStr(request.resource.data.olehNama, 120)
          && request.resource.data.waktu == request.time
          && request.resource.data.rev is int
          && string(request.resource.data.rev) == rev
          && getAfter(tindakPath(id)).data.rev == request.resource.data.rev
          && ((request.resource.data.aksi == 'buat') == (request.resource.data.rev == 1))
          && (!('catatan' in request.resource.data) || isStr(request.resource.data.catatan, 2000));

        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------- dokumen (metadata berkas)
    //
    // Metadata dokumen di sini adalah sumber data utama; berkasnya di Firebase Storage (storage.rules
    // mengunci akses berkas ke dokumen ini). Alur: metadata DULU (status 'mengunggah', rincian di
    // `pending`) → berkas diunggah ke path itu → difinalisasi. Lihat docs/DOKUMEN.md.

    // Nilai berikut HARUS sama dengan src/features/documents/config.ts dan storage.rules;
    // tests/rules/dokumen-config.test.ts memastikan ketiganya tidak berbeda.
    function maksUkuran() {
      return 10485760;
    }

    function maksVersi() {
      return 20;
    }

    function mimeDiizinkan(m) {
      return m in ['application/pdf',
                   'application/msword',
                   'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                   'application/vnd.ms-excel',
                   'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                   'text/csv',
                   'image/jpeg',
                   'image/png'];
    }

    // Ekstensi pada path penyimpanan harus sesuai MIME yang dinyatakan.
    function mimeCocokPath(path, m) {
      return (path.matches('.*[.]pdf') && m == 'application/pdf')
        || (path.matches('.*[.]doc') && m == 'application/msword')
        || (path.matches('.*[.]docx') && m == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document')
        || (path.matches('.*[.]xls') && m == 'application/vnd.ms-excel')
        || (path.matches('.*[.]xlsx') && m == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')
        || (path.matches('.*[.]csv') && m == 'text/csv')
        || (path.matches('.*[.]jpe?g') && m == 'image/jpeg')
        || (path.matches('.*[.]png') && m == 'image/png');
    }

    function idAman(v) {
      return v is string && v.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function judulValid(v) {
      return v is string && v.size() > 0 && v.size() <= 120;
    }

    // Jendela waktu untuk stempel dari jam klien di dalam array (array tidak boleh memuat serverTimestamp).
    function waktuWajar(t) {
      return t is timestamp
        && t > request.time - duration.value(10, 'm')
        && t < request.time + duration.value(10, 'm');
    }

    // Entri keputusan (review dokumen): pelaku = pemanggil; nama adalah snapshot tampilan.
    function entriKeputusanValid(e, status) {
      return e.keys().hasOnly(['status', 'oleh', 'nama', 'catatan', 'at'])
        && e.keys().hasAll(['status', 'oleh', 'nama', 'catatan', 'at'])
        && e.status == status
        && e.oleh == request.auth.uid
        && e.nama is string && e.nama.size() <= 100
        && e.catatan is string && e.catatan.size() <= 1000
        && waktuWajar(e.at);
    }

    function keputusanAwalValid(r, status) {
      return r is list && r.size() == 1 && entriKeputusanValid(r[0], status);
    }

    // Append-only: tepat satu entri baru di akhir; entri lama tidak boleh disentuh.
    function keputusanBertambah(lama, baru, status) {
      return baru is list
        && baru.size() == lama.size() + 1
        && baru[0:lama.size()] == lama
        && entriKeputusanValid(baru[lama.size()], status);
    }

    // Relasi dari klien tidak dipercaya: entitas harus ada dan milik sekolah yang sama.
    function supervisiSekolah(id, schoolId) {
      return idAman(id)
        && exists(supervisiPath(id))
        && get(supervisiPath(id)).data.schoolId == schoolId
        && get(supervisiPath(id)).data.deletedAt == null;
    }

    function tindakSekolah(id, schoolId) {
      return idAman(id)
        && exists(tindakPath(id))
        && get(tindakPath(id)).data.schoolId == schoolId;
    }

    // Guru harus ada, aktif, dan milik sekolah yang sama.
    function guruSah(schoolId, guruId) {
      return idAman(guruId)
        && exists(/databases/$(database)/documents/guru/$(guruId))
        && get(/databases/$(database)/documents/guru/$(guruId)).data.schoolId == schoolId
        && get(/databases/$(database)/documents/guru/$(guruId)).data.aktif == true;
    }

    // Fitur per sekolah, diatur pemilik di dokumen sekolah (klien tidak dapat menulisnya). Bawaan: mati.
    function fiturPengirimanGuruAktif(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data.get('fitur', {}).get('pengirimanDokumenGuru', false) == true;
    }

    function kunciDokumen() {
      return ['schoolId', 'kategori', 'supervisiId', 'guruId', 'tindakId', 'judul', 'status', 'currentVersion',
              'versions', 'pending', 'reviewStatus', 'reviewRiwayat', 'createdBy', 'createdByName', 'createdAt',
              'updatedAt', 'deletedAt', 'deletedBy'];
    }

    // Relasi harus sesuai kategori dan merujuk entitas se-sekolah (ID stabil, bukan nama).
    function relasiDokumenValid(d) {
      return (d.kategori in ['pendukung-supervisi', 'bukti-pelaksanaan', 'lampiran-rekomendasi']
              && d.guruId == null && d.tindakId == null
              && supervisiSekolah(d.supervisiId, d.schoolId))
        || (d.kategori == 'tindak-lanjut'
              && d.supervisiId == null && d.guruId == null
              && tindakSekolah(d.tindakId, d.schoolId))
        || (d.kategori == 'pengajuan-guru'
              && d.supervisiId == null && d.tindakId == null
              && guruSah(d.schoolId, d.guruId)
              && fiturPengirimanGuruAktif(d.schoolId))
        || (d.kategori in ['template', 'administratif']
              && d.supervisiId == null && d.guruId == null && d.tindakId == null);
    }

    // Rincian satu berkas. Path dikunci ke sekolah, dokumen, dan nomor versi; nama objek wajib UUID
    // (nama asli berkas hanya disimpan sebagai teks tampilan, tidak pernah menjadi path).
    function berkasValid(p, schoolId, docId, n) {
      return p.keys().hasAll(['n', 'storagePath', 'fileName', 'mimeType', 'size', 'sha256', 'uploadedBy'])
        && p.n == n
        && p.storagePath is string
        && p.storagePath.matches('sekolah/' + schoolId + '/dokumen/' + docId + '/v' + string(n)
                                 + '/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.](pdf|doc|docx|xls|xlsx|csv|jpg|jpeg|png)')
        && p.mimeType is string && mimeDiizinkan(p.mimeType) && mimeCocokPath(p.storagePath, p.mimeType)
        && p.size is int && p.size > 0 && p.size <= maksUkuran()
        && p.sha256 is string && p.sha256.matches('[0-9a-f]{64}')
        && p.fileName is string && p.fileName.size() > 0 && p.fileName.size() <= 120;
    }

    function pendingValid(p, schoolId, docId, n) {
      return p is map
        && p.keys().hasOnly(['n', 'storagePath', 'fileName', 'mimeType', 'size', 'sha256', 'uploadedBy', 'startedAt'])
        && p.keys().hasAll(['startedAt'])
        && berkasValid(p, schoolId, docId, n)
        && p.uploadedBy == request.auth.uid
        && waktuWajar(p.startedAt);
    }

    function versiDariPending(v, p) {
      return v is map
        && v.keys().hasOnly(['n', 'storagePath', 'fileName', 'mimeType', 'size', 'sha256', 'uploadedBy', 'uploadedAt'])
        && v.n == p.n
        && v.storagePath == p.storagePath
        && v.fileName == p.fileName
        && v.mimeType == p.mimeType
        && v.size == p.size
        && v.sha256 == p.sha256
        && v.uploadedBy == p.uploadedBy
        && waktuWajar(v.uploadedAt);
    }

    function reviewAwalValid(d) {
      return (d.kategori == 'pengajuan-guru' && d.reviewStatus == 'diajukan' && keputusanAwalValid(d.reviewRiwayat, 'diajukan'))
        || (d.kategori != 'pengajuan-guru' && d.reviewStatus == null && d.reviewRiwayat == []);
    }

    // Sama dengan src/features/documents/review.ts.
    function reviewTransisiSah(dari, ke) {
      return (dari == 'diajukan' && ke in ['disetujui', 'ditolak', 'perlu_revisi'])
        || (dari == 'perlu_revisi' && ke == 'diajukan');
    }

    function dokDiff() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function pembuatAtauAdminDok() {
      return resource.data.createdBy == request.auth.uid || isAdmin(resource.data.schoolId);
    }

    // Menambah tepat satu versi yang identik dengan `pending`, lalu mengosongkan `pending`.
    // Versi "perlu revisi" otomatis diajukan ulang dan tercatat.
    function dokFinalisasi() {
      let lama = resource.data;
      let baru = request.resource.data;
      return lama.pending != null
        && lama.pending.uploadedBy == request.auth.uid
        && lama.status in ['mengunggah', 'tersedia']
        && baru.status == 'tersedia'
        && baru.pending == null
        && baru.currentVersion == lama.pending.n
        && baru.versions.size() == lama.versions.size() + 1
        // Irisan list kosong ([0:0]) memicu galat indeks di runtime Rules, jadi ditangani terpisah.
        && (lama.versions.size() == 0 || baru.versions[0:lama.versions.size()] == lama.versions)
        && versiDariPending(baru.versions[lama.versions.size()], lama.pending)
        && (lama.reviewStatus == 'perlu_revisi'
            ? (dokDiff().hasOnly(['status', 'pending', 'currentVersion', 'versions', 'reviewStatus', 'reviewRiwayat', 'updatedAt'])
               && baru.reviewStatus == 'diajukan'
               && keputusanBertambah(lama.reviewRiwayat, baru.reviewRiwayat, 'diajukan'))
            : dokDiff().hasOnly(['status', 'pending', 'currentVersion', 'versions', 'updatedAt']));
    }

    function dokMulaiVersi(docId) {
      let lama = resource.data;
      let baru = request.resource.data;
      return lama.status == 'tersedia'
        && lama.pending == null
        && lama.createdBy == request.auth.uid
        && lama.currentVersion < maksVersi()
        && !(lama.reviewStatus in ['disetujui', 'ditolak'])
        && dokDiff().hasOnly(['pending', 'updatedAt'])
        && pendingValid(baru.pending, lama.schoolId, docId, lama.currentVersion + 1);
    }

    // Unggahan versi baru dibatalkan/gagal: versi yang sudah ada tetap utuh.
    function dokBatalkanPending() {
      return resource.data.pending != null
        && resource.data.pending.uploadedBy == request.auth.uid
        && resource.data.versions.size() > 0
        && request.resource.data.pending == null
        && dokDiff().hasOnly(['pending', 'updatedAt']);
    }

    function dokUbahJudul() {
      return pembuatAtauAdminDok()
        && resource.data.status == 'tersedia'
        && dokDiff().hasOnly(['judul', 'updatedAt'])
        && judulValid(request.resource.data.judul);
    }

    function dokKeputusanReview() {
      let lama = resource.data;
      let baru = request.resource.data;
      return lama.status == 'tersedia'
        && lama.pending == null
        && lama.reviewStatus != null
        && dokDiff().hasOnly(['reviewStatus', 'reviewRiwayat', 'updatedAt'])
        && reviewTransisiSah(lama.reviewStatus, baru.reviewStatus)
        && keputusanBertambah(lama.reviewRiwayat, baru.reviewRiwayat, baru.reviewStatus)
        // Menolak atau meminta revisi wajib disertai alasan.
        && (!(baru.reviewStatus in ['ditolak', 'perlu_revisi'])
            || baru.reviewRiwayat[lama.reviewRiwayat.size()].catatan.size() > 0);
    }

    function dokHapusLunak() {
      let lama = resource.data;
      let baru = request.resource.data;
      return lama.status == 'tersedia'
        && lama.pending == null
        && pembuatAtauAdminDok()
        && dokDiff().hasOnly(['status', 'deletedAt', 'deletedBy', 'updatedAt'])
        && baru.status == 'dihapus'
        && baru.deletedAt == request.time
        && baru.deletedBy == request.auth.uid;
    }

    function dokPulihkan() {
      let lama = resource.data;
      let baru = request.resource.data;
      return lama.status == 'dihapus'
        && pembuatAtauAdminDok()
        && lama.versions.size() > 0
        && dokDiff().hasOnly(['status', 'deletedAt', 'deletedBy', 'updatedAt'])
        && baru.status == 'tersedia'
        && baru.deletedAt == null
        && baru.deletedBy == null;
    }

    match /documents/{docId} {
      // Metadata terlihat oleh seluruh pengguna aktif sekolah (termasuk yang terhapus-lunak, untuk tempat sampah).
      // `resource == null` (dokumen belum ada): pengguna aktif menerima "tidak ada" alih-alih galat izin,
      // sehingga unggahan dapat idempoten. Konsekuensi yang diterima: pengguna aktif dapat membedakan ID
      // yang tidak ada dari ID yang ada tetapi bukan miliknya (ID acak 20 karakter; isi tetap tertutup).
      allow get: if resource == null ? active() : inSchool(resource.data.schoolId);
      allow list: if inSchool(resource.data.schoolId);

      allow create: if request.resource.data.keys().hasOnly(kunciDokumen())
        && request.resource.data.keys().hasAll(kunciDokumen())
        && idAman(docId)
        && idAman(request.resource.data.schoolId)
        && inSchool(request.resource.data.schoolId)
        && request.resource.data.kategori in ['pendukung-supervisi', 'bukti-pelaksanaan', 'lampiran-rekomendasi',
                                              'tindak-lanjut', 'template', 'administratif', 'pengajuan-guru']
        && relasiDokumenValid(request.resource.data)
        && judulValid(request.resource.data.judul)
        && request.resource.data.status == 'mengunggah'
        && request.resource.data.currentVersion == 0
        && request.resource.data.versions == []
        && pendingValid(request.resource.data.pending, request.resource.data.schoolId, docId, 1)
        && reviewAwalValid(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string && request.resource.data.createdByName.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deletedAt == null
        && request.resource.data.deletedBy == null;

      allow update: if inSchool(resource.data.schoolId)
        && request.resource.data.keys().hasOnly(kunciDokumen())
        && request.resource.data.keys().hasAll(kunciDokumen())
        && request.resource.data.updatedAt == request.time
        && (dokFinalisasi() || dokMulaiVersi(docId) || dokBatalkanPending() || dokUbahJudul()
            || dokKeputusanReview() || dokHapusLunak() || dokPulihkan());

      // Hanya dua jalur hapus-permanen: unggahan pertama yang gagal (belum ada versi; oleh pengunggah),
      // atau dokumen yang sebelumnya dihapus-lunak (oleh pembuat atau admin sekolah). Berkas di Storage
      // dihapus LEBIH DULU oleh klien.
      allow delete: if inSchool(resource.data.schoolId)
        && ((resource.data.status == 'mengunggah' && resource.data.versions.size() == 0
             && resource.data.createdBy == request.auth.uid)
            || (resource.data.status == 'dihapus' && pembuatAtauAdminDok()));
    }

    // Selain yang tercantum di atas: ditolak.
  }
}
